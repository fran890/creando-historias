JWT_SECRET="super-secret-jwt-key-change-this-in-production-min-32-chars"
NEXT_PUBLIC_APP_URL="https://creando-historias.com"
DEFAULT_PLATFORM_SHARE_PERCENTAGE="30"
DEFAULT_AUTHOR_SHARE_PERCENTAGE="70"
NEXT_PUBLIC_ADSENSE_CLIENT_ID="ca-pub-6105500451798195"
NEXT_PUBLIC_ADSENSE_MODE="manual"

# Google Analytics 4 Measurement ID (ej: G-080W450VN1)
